# damai-ai integration env template (copy to .env in your shell/IDE run config)
# Reuse DAMAI_* values from damai-pro/.env when possible.

# Core service
DAMAI_AI_PORT=6089
DAMAI_AI_MYSQL_URL=
DAMAI_AI_MYSQL_USERNAME=
DAMAI_AI_MYSQL_PASSWORD=

# Optional: if not set, core service falls back to DAMAI_MYSQL_HOST / DAMAI_MYSQL_PORT
DAMAI_MYSQL_HOST=127.0.0.1
DAMAI_MYSQL_PORT=13306
DAMAI_MYSQL_USERNAME=root
DAMAI_MYSQL_PASSWORD=root

# AI model endpoints
DAMAI_AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
DAMAI_AI_OLLAMA_CHAT_MODEL=deepseek-r1:7b
DAMAI_AI_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
DAMAI_AI_OPENAI_CHAT_MODEL=qwen-max-latest
DAMAI_AI_OPENAI_EMBEDDING_MODEL=text-embedding-v3
DAMAI_AI_OPENAI_EMBEDDING_DIMENSIONS=1024
DAMAI_AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
DAMAI_AI_DEEPSEEK_CHAT_MODEL=deepseek-chat

# API keys (fill these)
DAMAI_AI_ALIBABA_API_KEY=__FILL_YOUR_QWEN_API_KEY__
DAMAI_AI_DEEPSEEK_API_KEY=__FILL_YOUR_DEEPSEEK_API_KEY__

# MCP + observability
DAMAI_AI_MCP_LOG_PORT=8085
DAMAI_AI_MCP_METRICS_PORT=8086
DAMAI_AI_PROMETHEUS_URL=http://127.0.0.1:9090
DAMAI_AI_MCP_LOG_URL=http://127.0.0.1:8085
DAMAI_AI_MCP_METRICS_URL=http://127.0.0.1:8086

# Integration endpoints to damai-pro
DAMAI_AI_ORDER_LIST_ADDRESS=http://127.0.0.1:5173/orderManagement/index
DAMAI_AI_PROGRAM_DETAIL_URL=http://127.0.0.1:6085/damai/program/program/detail
DAMAI_AI_TICKET_LIST_URL=http://127.0.0.1:6085/damai/program/ticket/category/select/list/by/program
DAMAI_AI_USER_DETAIL_URL=http://127.0.0.1:6085/damai/user/user/get/mobile
DAMAI_AI_TICKET_USER_LIST_URL=http://127.0.0.1:6085/damai/user/ticket/user/list
DAMAI_AI_CREATE_ORDER_URL=http://127.0.0.1:6085/damai/program/program/order/create/v1

# Shared ES from damai-pro Docker
DAMAI_ES_ADDR=127.0.0.1:19200
DAMAI_ES_USERNAME=elastic
DAMAI_ES_PASSWORD=elastic

