# damai-ai integration env template (copy to .env in your shell/IDE run config)
# Reuse DAMAI_* values from damai-pro/.env when possible.

# Core service
DAMAI_AI_PORT=6089
DAMAI_AI_CHANNEL_CODE=0001
DAMAI_AI_ADMIN_USER_IDS=
DAMAI_AI_MYSQL_URL=jdbc:mysql://127.0.0.1:13306/damai_ai?serverTimezone=Asia/Shanghai&useSSL=false&useUnicode=true&characterEncoding=utf-8&zeroDateTimeBehavior=convertToNull&transformedBitIsBoolean=true&tinyInt1isBit=false&allowPublicKeyRetrieval=true&allowMultiQueries=true&useServerPrepStmts=false
DAMAI_AI_MYSQL_USERNAME=root
DAMAI_AI_MYSQL_PASSWORD=root
DAMAI_INTERNAL_ACCESS_TOKEN=__CHANGE_ME_SHARED_INTERNAL_TOKEN__
DAMAI_ALLOW_UNSAFE_NO_VERIFY_FALLBACK=false

# Optional: if not set, core service falls back to DAMAI_MYSQL_HOST / DAMAI_MYSQL_PORT
DAMAI_MYSQL_HOST=127.0.0.1
DAMAI_MYSQL_PORT=13306
DAMAI_MYSQL_USERNAME=root
DAMAI_MYSQL_PASSWORD=root
DAMAI_RABBITMQ_HOST=127.0.0.1
DAMAI_RABBITMQ_AMQP_PORT=5672
DAMAI_RABBITMQ_USERNAME=damai
DAMAI_RABBITMQ_PASSWORD=damai
DAMAI_REDIS_HOST=127.0.0.1
DAMAI_REDIS_PORT=16379
DAMAI_REDIS_PASSWORD=

# AI model endpoints
DAMAI_AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
DAMAI_AI_OLLAMA_CHAT_MODEL=deepseek-r1:7b
DAMAI_AI_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
DAMAI_AI_OPENAI_CHAT_MODEL=qwen-max-latest
DAMAI_AI_OPENAI_EMBEDDING_MODEL=text-embedding-v3
DAMAI_AI_OPENAI_EMBEDDING_DIMENSIONS=1024
DAMAI_AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
DAMAI_AI_DEEPSEEK_CHAT_MODEL=deepseek-chat

# API keys (fill these)
DAMAI_AI_ALIBABA_API_KEY=__FILL_YOUR_QWEN_API_KEY__
DAMAI_AI_DEEPSEEK_API_KEY=__FILL_YOUR_DEEPSEEK_API_KEY__

# General chat web search
DAMAI_AI_WEB_SEARCH_ENABLED=true
DAMAI_AI_WEB_SEARCH_TIMEOUT_MS=5000
DAMAI_AI_WEB_SEARCH_MAX_RESULTS=5
DAMAI_AI_TAVILY_ENABLED=true
DAMAI_AI_TAVILY_API_KEY=__FILL_YOUR_TAVILY_API_KEY__
DAMAI_AI_TAVILY_API_KEYS=__FILL_TAVILY_KEY_1__,__FILL_TAVILY_KEY_2__
DAMAI_AI_TAVILY_URL=https://api.tavily.com/search
DAMAI_AI_BOCHA_ENABLED=true
DAMAI_AI_BOCHA_API_KEY=__FILL_YOUR_BOCHA_API_KEY__
DAMAI_AI_BOCHA_URL=https://api.bochaai.com/v1/web-search

# Observability and vector stores
DAMAI_AI_PROMETHEUS_URL=http://127.0.0.1:9090
DAMAI_AI_QDRANT_URL=http://127.0.0.1:16333
DAMAI_AI_QDRANT_COLLECTION=damai_ai_faq
DAMAI_AI_FAQ_ALIAS=damai-ai-faq-current

# OPS NL2SQL controlled data query
# Point this at a read-only analytics schema or a ShardingSphere logical datasource exposing only approved views.
DAMAI_AI_NL2SQL_ENABLED=false
DAMAI_AI_NL2SQL_SCHEMA_COLLECTION=damai_ai_nl2sql_schema
DAMAI_AI_NL2SQL_MAX_ROWS=100
DAMAI_AI_NL2SQL_SCHEMA_TOP_K=5
DAMAI_AI_NL2SQL_QUERY_TIMEOUT_MS=5000
DAMAI_AI_NL2SQL_REPAIR_ATTEMPTS=1
DAMAI_AI_NL2SQL_DRIVER=com.mysql.cj.jdbc.Driver
DAMAI_AI_NL2SQL_URL=
DAMAI_AI_NL2SQL_USERNAME=
DAMAI_AI_NL2SQL_PASSWORD=

# Integration endpoints to damai-pro
DAMAI_AI_ORDER_LIST_ADDRESS=http://127.0.0.1:15173/orderManagement/index
DAMAI_AI_PROGRAM_DETAIL_URL=http://127.0.0.1:6085/damai/program/program/detail
DAMAI_AI_TICKET_LIST_URL=http://127.0.0.1:6085/damai/program/ticket/category/select/list/by/program
DAMAI_AI_USER_DETAIL_URL=http://127.0.0.1:6085/damai/user/user/get/mobile
DAMAI_AI_CURRENT_USER_URL=http://127.0.0.1:6085/damai/user/user/current
DAMAI_AI_TICKET_USER_LIST_URL=http://127.0.0.1:6085/damai/user/ticket/user/list
DAMAI_AI_CREATE_ORDER_URL=http://127.0.0.1:6085/damai/program/program/order/create/v1

# Shared ES from damai-pro Docker
DAMAI_ES_ADDR=127.0.0.1:19200
DAMAI_ES_USERNAME=elastic
DAMAI_ES_PASSWORD=elastic

# Frontend/Vite
VITE_DAMAI_AI_BASE_URL=http://127.0.0.1:6089
VITE_DAMAI_AI_PROXY_TARGET=http://127.0.0.1:6089
VITE_DAMAI_PRO_LOGIN_URL=http://127.0.0.1:15173/login
